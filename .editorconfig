# EditorConfig — 跨编辑器统一缩进和换行
# VS Code 需安装 EditorConfig 插件
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,xml}]
indent_size = 4

[*.py]
indent_size = 4

[*.{md,sql}]
indent_size = 2

[Makefile]
indent_style = tab
